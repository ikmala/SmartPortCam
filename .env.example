# =============================================================================
# SmartPortCam — Environment Variables
# Salin ke .env: cp .env.example .env
# File .env TIDAK boleh di-commit ke Git.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartportcam
POSTGRES_USER=smartport
# GANTI password ini sebelum deploy ke production!
POSTGRES_PASSWORD=ganti_password_ini

# ── Web Dashboard ─────────────────────────────────────────────────────────
# URL rosbridge WebSocket
VITE_ROSBRIDGE_URL=ws://localhost:9090
# URL MJPEG stream dari web_video_server
# Multi-gate: gunakan wildcard di dashboard, bukan hardcode satu gate
VITE_YOLO_STREAM_URL=http://localhost:8080/stream?topic=/gate_1/vehicle/detections/image_raw&type=mjpeg

# ── Security ──────────────────────────────────────────────────────────────
# Binding rosbridge (0.0.0.0 = semua interface, 127.0.0.1 = lokal saja)
# Untuk production: ganti ke IP spesifik atau 127.0.0.1 + reverse proxy
ROSBRIDGE_ADDRESS=0.0.0.0
ROSBRIDGE_PORT=9090

# ── Gate (diisi otomatis oleh gate_manager, jangan diubah manual) ─────────
# SMARTPORT_GATE_ID=gate_1
